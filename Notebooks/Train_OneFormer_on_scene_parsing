ion_map,\n","                  task_inputs=[\"panoptic\"],\n","                  return_tensors=\"pt\",\n","                  size={\"height\": 512, \"width\": 512}\n","                  # padding=\"max_length\",\n","                  # truncation=True\n","                )\n","\n","        processed_inputs = {}\n","        for k, v in inputs.items():\n","            if isinstance(v, list) and len(v) > 0 and isinstance(v[0], torch.Tensor):\n","                processed_inputs[k] = v[0]\n","            elif isinstance(v, torch.Tensor):\n","                processed_inputs[k] = v.squeeze(0)\n","            else:\n","                processed_inputs[k] = v\n","        if \"task_inputs\" in processed_inputs:\n","          task_inputs = processed_inputs[\"task_inputs\"]\n","\n","          # Pad to length 77 (required by model)\n","          if task_inputs.shape[-1] < 77:\n","              pad_size = 77 - task_inputs.shape[-1]\n","              pad = torch.zeros(pad_size, dtype=task_inputs.dtype)\n","              task_inputs = torch.cat([task_inputs, pad], dim=-1)\n","\n","          processed_inputs[\"task_inputs\"] = task_inputs\n","        return processed_inputs"],"metadata":{"id":"AY_MWMucskme","executionInfo":{"status":"ok","timestamp":1777087053063,"user_tz":240,"elapsed":9,"user":{"displayName":"Adhithyaa Manoharan","userId":"08978597024351208130"}}},"execution_count":6,"outputs":[]},{"cell_type":"markdown","source":["## DataLoader"],"metadata":{"id":"XI-MUIJDPJHZ"}},{"cell_type":"code","source":["def collate_fn(batch):\n","    collated = {}\n","\n","    for key in batch[0].keys():\n","        if key in [\"pixel_values\", \"pixel_mask\", \"input_ids\", \"attention_mask\", \"task_inputs\", \"text_inputs\"]:\n","            collated[key] = torch.stack([b[key] for b in batch])\n","        else:\n","            collated[key] = [b[key] for b in batch]\n","\n","    return collated"],"metadata":{"id":"kDQ6C3jCbN_G","executionInfo":{"status":"ok","timestamp":1777087054741