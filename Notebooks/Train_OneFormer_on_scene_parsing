section\n","\n","    # Avoid division by zero\n","    iou = intersection / (union + 1e-10)\n","    # Average across classes that actually appear in GT or predictions\n","    present_indices = np.where(union > 0)[0]\n","    miou = np.mean(iou[present_indices])\n","\n","    return miou, iou\n","\n","# Example Usage during your testing loop\n","# miou_val, per_class_iou = calculate_miou(seg_array, gt_array)\n"]},{"cell_type":"code","source":["from pathlib import Path\n","import matplotlib.image as mpimg\n","import matplotlib.pyplot as plt\n","import matplotlib.image as mpimg\n","import cv2\n","\n","seg_path = Path(\"/content/drive/MyDrive/SBU/Advanced_Project_Robotics/Semantics/scene_parsing/release_test/results\")\n","\n","results_path = \"/content/drive/MyDrive/SBU/Advanced_Project_Robotics/Semantics/scene_parsing/model_evaluation_before_training.csv\"\n","\n","gt_path = Path(validation_annotations)\n","\n","seg_img_files = [f for f in seg_path.iterdir() if f.suffix.lower() in [\".jpg\", \".jpeg\", \".png\"]]\n","\n","print(f\"loading images from {seg_path}\")\n","\n","all_results = []\n","\n","def get_gt_img(file_name):\n","  gt_file = [f for f in gt_path.glob(file_name)][0]\n","  # gt_img = Image.open(gt_file).convert(\"L\")\n","  gt_img = cv2.imread(gt_file, 0)\n","  return gt_img\n","\n","def display_results(img1 ,img2, val):\n","  fig, axes = plt.subplots(1, 3, figsize=(10, 4))\n","\n","  axes[0].imshow(img1)\n","  axes[0].axis('off')\n","\n","  axes[1].imshow(img2)\n","  axes[1].axis('off')\n","\n","  axes[2].text(0.5, 0.5, val, fontsize=13, ha='center')\n","  axes[2].axis('off')\n","\n","  plt.show()\n","\n","for img_file in seg_img_files:\n","\n","  # seg_img = Image.open(img_file).convert(\"L\")\n","  seg_img = cv2.imread(img_file, 0)\n","\n","  gt_file_name = img_file.name.replace(\"_prediction\", \"\")\n","  gt_img = get_gt_img(gt_file_name)\n","\n","  # seg_array = np.array(seg_img)\n","  # gt_array = np.array(gt_img)\n","\n","  if gt_img.max() > 149:\n",